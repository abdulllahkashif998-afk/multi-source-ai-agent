# Server-only AI selection. Unset AI_PROVIDER also defaults to Gemini.
AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_REQUESTS_PER_MINUTE=12

# To use Groq, set AI_PROVIDER=groq and supply this credential privately.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REQUESTS_PER_MINUTE=12
# Verified alternative: openai/gpt-oss-120b

# Local setup placeholders only. Never overwrite an existing .env.local.
DATABASE_URL=postgresql://APP_USER:REPLACE_LOCALLY@127.0.0.1:5432/APP_DATABASE
APP_ORIGIN=http://localhost:3000
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=hf.co/CompendiumLabs/bge-base-en-v1.5-gguf:Q8_0
DOCUMENT_SEARCH_MODE=hybrid
RAG_MIN_SIMILARITY=0.5
ALLOW_LIVE_AI_EVAL=0

# Production requires an explicit HTTPS APP_ORIGIN. Provider secrets stay blank.
# FRESH_DATABASE_URL is an operator-only setup variable; see docs/database.md.
# Do not give the application a database administrator credential.

# Private persistent ledger, shared by same-host workers; never serve publicly.
# Keep this directory across normal restarts. No API keys/prompts are stored.
GROQ_QUOTA_DIRECTORY=storage/groq-quota